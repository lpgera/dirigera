{
  "extends": ["@tsconfig/strictest/tsconfig", "@tsconfig/node22/tsconfig"],
  "include": ["src"],
  "exclude": ["test", "dist", "scratch"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  }
}
